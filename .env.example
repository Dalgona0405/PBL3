# ===================================================================
# Smart Job Seeking & ATS Platform (SJSP-2026) - Environment Template
# Sao chep thanh file .env va dien cac gia tri cua ban truoc khi chay Docker Compose
# ===================================================================

# --- 1. DATABASE & JWT (BAT BUOC) ---
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=JobSeeking_DB
# Sinh chuoi ngau nhien toi thieu 32 ky tu (KHONG dung lai key mau trong git history)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_WITH_AT_LEAST_32_CHARACTERS

# --- 2. GOOGLE OAUTH 2.0 (TUY CHON - bat buoc neu dung dang nhap Google) ---
GOOGLE_CLIENT_ID=

# --- 3. CLOUDINARY CDN (TUY CHON - luu anh avatar & logo; thieu se fallback luu local) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- 4. SUPABASE STORAGE (TUY CHON o Development; BAT BUOC o Production de luu CV PDF) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CV_BUCKET=resumes

# --- 5. SMTP EMAIL (TUY CHON - gui email phong van kem lich .ics; thieu se ghi mock log) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
